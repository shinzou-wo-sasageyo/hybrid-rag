# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# Embeddings: "local" runs BAAI/bge-small-en-v1.5 offline (no key, 384 dims).
# Swap to "voyage" or "openai" to use a hosted model (see embeddings.py).
EMBEDDING_BACKEND=local
EMBEDDING_DIM=384

# Generation (optional — retrieval + eval run without this).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
